{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPUB有声书生成器",
  "version": "0.1.0",
  "identifier": "com.local.epub-mstts-audio",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EPUB电子书音频生成器",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/mstts", "resources/voices"]
  }
}
